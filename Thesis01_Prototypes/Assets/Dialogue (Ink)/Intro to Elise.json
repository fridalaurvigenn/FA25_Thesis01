{"inkVersion":21,"root":[[{"->":"elise_intro"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"elise_intro":["^You approach the elderly woman by the dock.","\n",{"->":"START"},{"#f":1}],"START":["ev",{"VAR?":"greeted"},false,"==","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"FIRST_MEETING"},{"->":"START.7"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"RETURN_MEETING"},{"->":"START.7"},null]}],"nop","\n",{"#f":1}],"FIRST_MEETING":[["ev",true,"/ev",{"VAR=":"greeted","re":true},"^Elderly Woman: You’re not from around here... I’m Elise.","\n","^ELISE: The tide’s quieter than usual today.","\n","^ELISE: Or maybe it's you bringing the silence with you.","\n",["ev",{"^->":"FIRST_MEETING.0.10.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^Just passing through.",{"->":"$r","var":true},null]}],["ev",{"^->":"FIRST_MEETING.0.11.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-1","flg":2},{"s":["^I’ve heard stories. My mother lived here once.",{"->":"$r","var":true},null]}],["ev",{"^->":"FIRST_MEETING.0.12.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-2","flg":2},{"s":["^I’m looking for answers. Something my mother believed in.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"FIRST_MEETING.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.10.s"},[{"#n":"$r2"}],"\n","^ELISE: Mm. Most who pass through don’t look like they’ve come back.","\n",{"->":"MAIN_LOOP"},{"#f":5}],"c-1":["ev",{"^->":"FIRST_MEETING.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.11.s"},[{"#n":"$r2"}],"\n","ev",true,"/ev",{"VAR=":"mentionedMother","re":true},"^ELISE: Hmph. There’s always someone who used to live here.","\n","^ELISE: This town remembers the ones it wants to. The rest... fade.","\n",{"->":"MAIN_LOOP"},{"#f":5}],"c-2":["ev",{"^->":"FIRST_MEETING.0.c-2.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.12.s"},[{"#n":"$r2"}],"\n","ev",true,"/ev",{"VAR=":"mentionedMother","re":true},"^ELISE: Ah. So 